{
  "name": "vista-compass",
  "displayName": "VistA Compass",
  "description": "A compass for VistA's code. Point it at any .m routine to get your bearings, then click any reference, call-in, call-out, global, or XINDEX finding to navigate through all of VistA's interconnected web of routines, FileMan files, pointers, RPCs, options, protocols, and globals. Every row in the sidebar is a clickable jump. Drawn from vista-meta code-model TSVs. No language server, no parser, no runtime deps.",
  "version": "0.1.0",
  "publisher": "rafael5",
  "icon": "media/icon.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.m"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mumps",
        "aliases": ["MUMPS", "M", "mumps"],
        "extensions": [".m"],
        "configuration": "./language-configuration.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vistaCompassRoutine",
          "name": "VistA Routine"
        }
      ]
    },
    "commands": [
      {
        "command": "vistaCompass.refresh",
        "title": "VistA Compass: Refresh Routine Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "vistaCompass.reloadTsvs",
        "title": "VistA Compass: Reload Code-Model TSVs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vistaCompass.refresh",
          "when": "view == vistaCompassRoutine",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VistA Compass",
      "properties": {
        "vistaCompass.codeModelPath": {
          "type": "string",
          "default": "vista/export/code-model",
          "description": "Workspace-relative path to the code-model TSV directory."
        },
        "vistaCompass.vistaMHostPath": {
          "type": "string",
          "default": "vista/vista-m-host",
          "description": "Workspace-relative path to the synced VistA-M host tree."
        },
        "vistaCompass.topN": {
          "type": "number",
          "default": 15,
          "description": "Maximum entries to show in each section (callers, callees, etc.)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rafael5/vista-meta"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  }
}
