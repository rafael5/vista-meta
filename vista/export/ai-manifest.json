    "meta_db": "make meta-db \u2192 dist/vista-meta-data-v1.db \u2014 generated SQLite projection (24 tables + entity_bridge + join views v_rpc_impl / v_option_impl / v_global_file_piks / v_routine_global_piks / v_rpc_data_piks / v_package_overview); the TSVs stay canonical",
    "sqlite_recipe": "cd ~/projects/vista-meta/vista/export\nsqlite3 :memory: <<'SQL'\n.mode tabs\n.import code-model/rpcs.tsv rpcs\n.import code-model/routines-comprehensive.tsv r\nSELECT rpcs.name, rpcs.tag, rpcs.routine_name, r.package, r.line_count\nFROM rpcs JOIN r ON r.routine_name = rpcs.routine_name\nWHERE rpcs.name LIKE 'ORWPT%' LIMIT 20;\nSQL",
    "tsv_root": "vista/export",
    "verbs": {
      "callers [TAG^]ROUTINE": "reverse call graph (measured, ranked)",
      "context <pkg> [--with-source]": "AI context pack",
      "doctor": "environment health check",
      "file <N> [--fields N]": "FileMan file + PIKS + pointers + fields",
      "pkg <name>": "package overview (namespace, footprint, PIKS mix)",
      "search <regex> [--package P] [--tags-only]": "annotated corpus grep",
      "where TAG^ROUTINE": "locate source"
    }
