# vista-meta runtime configuration
# Copy to .env and fill in your values. This file is gitignored.
# Spec: docs/historical/vista-meta-spec-v0.4.md § 12


# Optional: SSH password for the vehu user (default: vehu)
# VEHU_PASSWORD=vehu

# Optional: bake.sh parallelism (default: 1, serial)
# Values >1 not yet verified safe — see spec § 15, risk #7
# BAKE_WORKERS=1

# Host-port offsets (container-side ports never change). Override when a
# sibling container already holds the default on 127.0.0.1 — e.g. the m-cli
# 'vehu' engine stack binds 8001/9430, vista-iris binds 9430.
#RPC_PORT=9530
#VLINK_PORT=8101
