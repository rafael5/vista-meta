# vista-meta runtime configuration — OPTIONAL.
#
# There is no required configuration. The stack builds and runs with no
# .env file at all (published ports bind to 127.0.0.1, local-only).
#
# Copy to .env ONLY if you want to override a default below. .env is
# gitignored. Spec: docs/vista-meta-spec-v0.4.md § 12

# Host bind address for the container's published ports (SSH 2222,
# RPC Broker 9430, VistALink 8001). Default: 127.0.0.1 (local-only).
# Set to a specific host interface IP to expose the engine to other
# machines on that network (e.g. a private overlay / VPN address).
# HOST_BIND_IP=127.0.0.1

# SSH password for the vehu user (default: vehu)
# VEHU_PASSWORD=vehu

# bake.sh parallelism (default: 1, serial)
# Values >1 not yet verified safe — see spec § 15, risk #7
# BAKE_WORKERS=1
